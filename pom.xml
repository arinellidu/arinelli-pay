<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>br.com.arinelli.pay</groupId>
  <artifactId>arinelli-pay</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>arinelli-pay</name>
  <description>Arinelli Pay — multi-rail billing SaaS (Pix, boleto/QR, cartão)</description>

  <modules>
    <module>services/billing-core</module>
    <module>services/payments-core</module>
    <module>services/gateway</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <spring-cloud.version>2025.1.2</spring-cloud.version>
    <!-- Alinhado ao spring-boot-testcontainers 4.1.0 (Boot 4 não gerencia mais o Testcontainers) -->
    <testcontainers.version>2.0.5</testcontainers.version>
    <!-- standalone: Jetty/Jackson vêm shaded, sem brigar com os do Boot 4 -->
    <wiremock.version>3.13.1</wiremock.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
